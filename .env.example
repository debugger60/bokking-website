# ------------------------------------------------------------------
# CineBook AI — environment configuration
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# NEVER commit the real `.env` file (it is git-ignored).
# ------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Secret used to sign session cookies. Use a long, random string.
SESSION_SECRET=change-me-to-a-long-random-secret-string

# Path to the SQLite database file.
# Relative paths are resolved from the project root.
DB_PATH=./database/cinebook.db

# development | production
NODE_ENV=development

# Optional: allowed CORS origin (only needed if the frontend is served
# from a different origin than the API).
# CORS_ORIGIN=http://localhost:5500
